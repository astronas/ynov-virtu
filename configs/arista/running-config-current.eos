! Command: show running-config
! device: YNOV-SW-LAB (DCS-7050TX-64, EOS-4.20.12M)
!
! boot system flash:/EOS-4.20.12M.swi
!
transceiver qsfp default-mode 4x10G
!
hostname YNOV-SW-LAB
!
spanning-tree mode mstp
!
no aaa root
!
username admin role network-admin secret sha512 $6$bpFgkM9xz7lSI5Td$icY0etuP39vqhTGSPN1h.F1.U/qT620SOsVzr1YYTxLooulQ7TxcsdzNfjfz4hKAFDA0ly/Ebh0GTM.O5CrHt0
!
environment fan-speed override 30
!
vlan 10
   name MGMT
!
vlan 20
   name DMZ
!
vlan 30
   name SRV-LAN
!
vlan 99
   name WAN-FUTUR-OPNSENSE
!
vlan 101
   name CEPH-PUBLIC
!
vlan 102
   name CEPH-PRIVATE
!
vlan 4094
   name BLACKHOLE-NATIVE
!
interface Port-Channel1
   description PRX1-CEPH-LACP-2x10G
   mtu 9000
   switchport trunk native vlan 4094
   switchport trunk allowed vlan 101-102
   switchport mode trunk
!
interface Port-Channel2
   description PRX3-CEPH-LACP-2x10G
   mtu 9000
   switchport trunk native vlan 4094
   switchport trunk allowed vlan 101-102
   switchport mode trunk
!
interface Ethernet1
   description WAN-WINDOWS-10.0.99.1-VERS-OPNSENSE
   switchport access vlan 99
   spanning-tree portfast
!
interface Ethernet2
   description PRX1-TRUNK-MGMT-DMZ-SRV-PROD
   switchport access vlan 10
   switchport trunk native vlan 10
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   spanning-tree portfast
!
interface Ethernet3
   description PRX2-TRUNK-MGMT-DMZ-SRV-PROD
   switchport access vlan 10
   switchport trunk native vlan 10
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   spanning-tree portfast
!
interface Ethernet4
   description PRX3-TRUNK-MGMT-DMZ-SRV-WAN-OPNSENSE
   switchport access vlan 10
   switchport trunk native vlan 10
   switchport trunk allowed vlan 10,20,30,99
   switchport mode trunk
   spanning-tree portfast
!
interface Ethernet5
   description PC-ADMIN-MGMT
   switchport access vlan 10
   spanning-tree portfast
!
interface Ethernet6
   description PRX2-CEPH-PUBLIC-NIC2-SFP-RJ45
   switchport access vlan 101
   spanning-tree portfast
!
interface Ethernet7
   description PC-ADMIN-MGMT2
   switchport access vlan 10
   spanning-tree portfast
!
interface Ethernet8-48
   description UNUSED-BLACKHOLE
   shutdown
   switchport access vlan 4094
   spanning-tree portfast
!
interface Ethernet49/1
   description PRX1-CEPH-SFP-LINK1
   mtu 9000
   channel-group 1 mode active
!
interface Ethernet49/2
   description PRX1-CEPH-SFP-LINK2
   mtu 9000
   channel-group 1 mode active
!
interface Ethernet49/3
   description PRX3-CEPH-SFP-LINK1
   mtu 9000
   channel-group 2 mode active
!
interface Ethernet49/4
   description PRX3-CEPH-SFP-LINK2
   mtu 9000
   channel-group 2 mode active
!
interface Ethernet50/1-52/4
   description UNUSED-BLACKHOLE
   shutdown
   switchport access vlan 4094
!
interface Management1
   description OOB-MGMT-OPTIONNEL
   shutdown
!
interface Vlan1
   description UNUSED - VLAN1 neutralise
   shutdown
!
interface Vlan10
   description MGMT-LAB
   ip address 10.0.10.253/24
!
ip route 0.0.0.0/0 10.0.10.254
!
ip routing
!
end
