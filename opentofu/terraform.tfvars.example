proxmox_api_url = "https://pve.example.local:8006/api2/json"
# Authentification recommandee avec un token API Proxmox.
proxmox_api_token_id     = "terraform-prov@pve!terraform"
proxmox_api_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Alternative user/password si tu n'utilises pas de token.
# proxmox_user     = "root@pam"
# proxmox_password = "password"

target_node     = "pve"
template_name   = "debian-12-cloudinit-template"
storage         = "local-lvm"
bridge          = "vmbr0"
vlan_id         = 30
gateway         = "192.168.10.1"
search_domain   = "lab.local"
dns_servers     = ["192.168.10.1", "1.1.1.1"]
ci_user         = "admin"
# ci_password  = "ChangeMe-OnlyForLab"

