# terraform.tfvars.example — Copier en terraform.tfvars et adapter
# NE JAMAIS committer terraform.tfvars dans Git (contient des secrets)

# ── Connexion Proxmox ─────────────────────────────────────────────────────────
proxmox_endpoint     = "https://10.0.10.1:8006"
proxmox_username     = "terraform@pve"
proxmox_password     = "CHANGE_ME"
proxmox_insecure     = true
proxmox_ssh_user     = "root"
proxmox_ssh_password = "CHANGE_ME"

# ── Cloud-init ────────────────────────────────────────────────────────────────
vm_default_user     = "ynov"
vm_default_password = "CHANGE_ME"
vm_ssh_public_key   = "ssh-ed25519 AAAA... user@machine"

# ── Stockage ──────────────────────────────────────────────────────────────────
datastore_local = "local-lvm"
datastore_iso   = "local"
datastore_ceph  = "vm-pool"

# ── OPNsense ──────────────────────────────────────────────────────────────────
opnsense_iso  = "local:iso/OPNsense-25.1-dvd-amd64.iso"
opnsense_node = "prx3"

# ── Placement VMs DMZ ─────────────────────────────────────────────────────────
cloudflared_node = "prx3"
rproxy_node      = "prx3"
