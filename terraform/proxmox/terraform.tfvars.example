# terraform.tfvars.example — Copier en terraform.tfvars et adapter
# NE JAMAIS committer terraform.tfvars dans Git (contient des secrets)

# ── Connexion Proxmox ─────────────────────────────────────────────────────────
proxmox_api_url          = "https://10.0.10.1:8006/api2/json"
proxmox_api_token_id     = "root@pam!terraform"    # Proxmox : Datacenter > API Tokens
proxmox_api_token_secret = "CHANGE_ME"             # UUID du secret du token
proxmox_insecure         = true

# ── Stockage ──────────────────────────────────────────────────────────────────
datastore_local = "local-lvm"
datastore_iso   = "local"
datastore_ceph  = "vm-pool"

# ── VMs ───────────────────────────────────────────────────────────────────────
# Template cloné par défaut (doit exister sur le nœud cible).
default_template = "tmpl-debian"

# L'inventaire des VMs (variable `vms`) se définit par environnement, p.ex.
# dans env.prod.tfvars, et se passe avec -var-file="env.prod.tfvars".
