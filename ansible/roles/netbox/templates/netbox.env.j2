# {{ ansible_managed }}
# Genere par le role Ansible netbox — NE PAS editer a la main sur l'hote.

# ── Base de donnees PostgreSQL (conteneur `postgres`) ───────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME={{ netbox_db_name }}
DB_USER={{ netbox_db_user }}
DB_PASSWORD={{ netbox_db_password }}
DB_WAIT_DEBUG=1

# ── Redis file d'attente (conteneur `redis`) ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD={{ netbox_redis_password }}
REDIS_SSL=false

# ── Redis cache (conteneur `redis-cache`) ───────────────────────────────────────
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DATABASE=1
REDIS_CACHE_PASSWORD={{ netbox_redis_cache_password }}
REDIS_CACHE_SSL=false

# ── Application NetBox ──────────────────────────────────────────────────────────
SECRET_KEY={{ netbox_secret_key }}
ALLOWED_HOSTS={{ netbox_allowed_hosts }}
HOUSEKEEPING_INTERVAL=86400
GRAPHQL_ENABLED=true
WEBHOOKS_ENABLED=true
MEDIA_ROOT=/opt/netbox/netbox/media

# ── Compte super-utilisateur cree au 1er demarrage ──────────────────────────────
SKIP_SUPERUSER=false
SUPERUSER_NAME={{ netbox_superuser_name }}
SUPERUSER_EMAIL={{ netbox_superuser_email }}
SUPERUSER_PASSWORD={{ netbox_superuser_password }}
SUPERUSER_API_TOKEN={{ netbox_superuser_api_token }}
