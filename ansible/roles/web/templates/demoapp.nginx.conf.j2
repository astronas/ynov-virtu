# {{ ansible_managed }}
# Vhost de l'application demoapp (TD monitoring).
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root {{ demoapp_web_root }};
    index index.php;

    # Pages applicatives : login.php, dashboard.php, health.php (endpoint de sante).
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:{{ php_fpm_socket }};
    }

    # Ne jamais servir les fichiers caches (.git du depot clone, etc.).
    location ~ /\. {
        deny all;
    }
}
